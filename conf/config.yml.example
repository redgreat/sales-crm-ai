# sales-crm-ai 统一配置样例。
# 复制为 conf/config.yml 后填写；config.yml 含密钥，不入库（已加入 .gitignore）。
# 也可用环境变量 SAI_CONFIG 指定其他配置文件路径（只指路径，不承载密钥）。
# 本地配置后台将非密钥设置写入 conf/config.ui.yml（被 gitignore），保存后需重启服务。

# 运行环境：dev / test / prod
# prod 强制：model.provider 不得为 stub、auth.service_secret 必填、playground 禁用
environment: dev

# PostgreSQL（AI 专用库，业务表与 checkpoint 同库）
database_url: postgresql://postgres:postgres@127.0.0.1:55432/sales_crm_ai
db_pool_min: 1
db_pool_max: 10

# 模型：直连 Provider，不经任何网关
model:
  provider: stub            # stub（开发联调）| openai_compatible（直连供应商）
  # base_url: https://api.example.com/v1
  # api_key: 占位符-请替换
  # name: your-model-name
  # 百炼/MaaS 深度思考：默认 false（本服务非流式 + JSON，不适合开思考）。
  # 需要思考时改为 true（且须改用流式，当前链路未接）；非百炼端点可写 null 表示不传该参数。
  enable_thinking: false
  temperature: 0.2
  timeout_seconds: 60
  max_retries: 2

# 服务间认证（CRM -> AI 入站签名；与 CRM 集成层约定的 key/secret）
auth:
  service_key_id: crm-ai
  service_secret: 占位符-请替换
  timestamp_window_seconds: 300
  nonce_ttl_seconds: 600

# CRM 集成（AI -> CRM 出站授权事实查询 / P5 附件受控访问；base_url 留空则不启用出站客户端）
# 冻结契约（P4，2026-10-01；P5 附件 2026-10-07）：
#   GET {base_url}/ai/integration/facts/{subject_type}/{subject_id}
#   GET {base_url}/ai/integration/files/{file_id}          （附件元数据+受控访问方式）
#   GET {base_url}/ai/integration/files/{file_id}/content  （仅 CRM local 存储模式取字节）
#   签名见 app/auth.py；事实返回 {found, facts:{...}}，附件返回 {found, file, access}。
#   base_url 必须含 CRM 应用前缀，例如 http://127.0.0.1:8080/api/v1/salescrm
#   key_id/secret 与 CRM 端 salescrm.ai.key-id / AI_SERVICE_AUTH_SECRET 同源（双向同钥，crm-ai）
crm:
  base_url: ""
  key_id: crm-ai
  secret: ""
  timeout_seconds: 10

# 外部企业信息检索：仅返回人工核实线索，不自动创建/修改客户或联系人。
# 供应商 MCP 地址和 tool_name 以实际开通合同/服务文档为准；不能填网页地址。
# 密钥推荐环境变量 SAI_BOCHA_MCP_API_KEY / SAI_QICHACHA_MCP_API_KEY。
research:
  bocha:
    enabled: false
    url: ""
    api_key: ""
    tool_name: ""
    query_argument: query
  qichacha:
    enabled: false
    url: ""
    api_key: ""
    tool_name: ""
    query_argument: query

# ---------- 增强输入（P5 需求 4.12 录音 / 4.13 图片）----------
# 默认全部 false：凭据齐备后再把 enabled 改为 true。
# 启用但凭据缺失会直接拒绝启动，绝不回退为"假装识别成功"。
#
# 密钥两种给法（环境变量优先于本文件，推荐部署时用环境变量，密钥不落盘）：
#   SAI_MODEL_API_KEY（model.api_key）
#   SAI_CRM_SECRET（crm.secret，与 CRM 端 AI_SERVICE_AUTH_SECRET 同值）
#   SAI_ASR_API_KEY / SAI_ASR_WORKSPACE_ID
#   SAI_OCR_ACCESS_KEY_ID / SAI_OCR_ACCESS_KEY_SECRET
#   SAI_OSS_ACCESS_KEY_ID / SAI_OSS_ACCESS_KEY_SECRET / SAI_OSS_ENDPOINT / SAI_OSS_BUCKET
# 容器部署见仓库根 docker-compose.yml（镜像 ghcr.io/redgreat/sales-crm-ai）。

# ASR 录音文件识别（阿里云百炼 DashScope）
# 开通：百炼控制台开通服务 → 创建 API Key
# 硬约束：百炼只接受公网可访问的 URL，不支持本地文件/Base64
#         → 本地音频需先入 OSS（见下方 oss）取 URL，或由调用方直接给公网 url
asr:
  enabled: false
  provider: dashscope
  api_key: ""                 # ← 百炼 API Key 填这里
  workspace_id: ""            # 业务空间 ID（专属域名用）；留空走 dashscope.aliyuncs.com
  region: cn-beijing
  model: paraformer-v2
  language_hints: ["zh"]
  diarization_enabled: true   # 说话人分离（仅单声道、建议≤2h）；只出 speaker_id，不映射员工
  timeout_seconds: 30
  poll_interval_seconds: 3
  poll_timeout_seconds: 900

# 对象存储：为 ASR 提供公网 URL（ASR 的硬依赖）
# 未启用时，ASR 只能识别调用方自行提供的公网 URL
oss:
  enabled: false
  endpoint: ""                # 如 https://oss-cn-hangzhou.aliyuncs.com
  bucket: ""
  access_key_id: ""           # ← 可与下方 OCR 共用同一个 AccessKey
  access_key_secret: ""       # ←
  signed_url_ttl_seconds: 3600

# OCR 图片文字识别（阿里云文字识别 OCR）
# 开通：实名认证 → https://ocr.console.aliyun.com/ 按需开通（开通免费、赠免费额度）
# 凭据是 AccessKey（不是 API Key）；图片支持 Url 或二进制，故不强依赖 OSS
ocr:
  enabled: false
  access_key_id: ""           # ← 填这里
  access_key_secret: ""       # ← 填这里
  endpoint: ocr-api.cn-hangzhou.aliyuncs.com
  type: Advanced              # 通用文字识别高精版
  output_coordinate: points   # 原图锚点：points | rectangle | ""（不返回坐标）
  timeout_seconds: 30

# worker：队列扫描与租约
worker:
  enabled: true
  concurrency: 2
  poll_interval_seconds: 0.5
  lease_seconds: 120
  max_attempts: 3
  backoff_base_seconds: 2.0
  reap_interval_seconds: 5.0
  shutdown_grace_seconds: 5.0  # 容器停止时等待 worker 正常退出的秒数

# API
api:
  host: 127.0.0.1
  port: 8310
  # 开发联调代理（前端 playground 经此免签名访问，服务端注入固定联调身份）
  # 仅 dev/test 且显式开启才生效；生产开启会拒绝启动
  playground:
    enabled: true
    operator_user_id: dev-playground
    operator_user_name: 开发联调

# 配置后台（前端已打包进镜像，由 API 同端口挂在 /admin）
# enabled：总开关，关闭时页面与后台 API 一律 404
# allow_prod：生产环境放行；默认关闭，确需在生产维护配置时才置 true（建议仅内网访问）
admin:
  enabled: true
  allow_prod: false

log_level: INFO
